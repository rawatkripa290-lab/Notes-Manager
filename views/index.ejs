
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task Manager</title>

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
  <div class="main w-full min-h-screen bg-zinc-900">

    <div class="form p-10">
      <form action="/create" method="POST">
        <input
          class="block px-5 py-2 bg-zinc-300 border-2 mt-10 w-full text-black"
          type="text"
          name="title"
          placeholder="Here are the tasks"
        />

        <textarea
          class="block px-5 py-2 bg-zinc-300 border-2 mt-10 resize-none w-full text-black"
          name="details"
          placeholder="Write your tasks here"
        ></textarea>

        <input
          class="border-2 mt-10 w-full bg-blue-300 h-10 cursor-pointer"
          type="submit"
          value="Create task"
        />
      </form>
    </div>

    <div class="tasks p-10 flex gap-3 flex-wrap">

      <% if (files.length > 0) { %>

        <% files.forEach(function(val) { %>

          <div class="task w-72 px-3 py-4 bg-blue-800 rounded-md shadow-md">
            <h1 class="text-2xl text-white tracking-tight">
              <%= val%>
            </h1>
            <a
              class="text-white hover:text-black inline-block mt-3"
              href="/file/<%= val%>"
            >
              Read More.
            </a>
          </div>
        <% }) %>
      <% } else { %>
        <h3 class="text-zinc-600 text-2xl">
          No tasks yet.
        </h3>
      <% } %>
    </div>
  </div>
  <script src="/javascripts/script.js"></script>
</body>
</html>
